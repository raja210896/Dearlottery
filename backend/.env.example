ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=LotteryAnalyticsDb;Trusted_Connection=True;TrustServerCertificate=True
# ASP.NET Core binds nested config from env vars using "__" as the section separator.
# These map to appsettings' Sambad:BaseUrl / Sambad:Token (SambadOptions).
Sambad__BaseUrl=https://sambad-api.example.com
Sambad__Token=
Jwt__Secret=change-me-to-a-long-random-secret
Jwt__Issuer=LotteryAnalytics
Jwt__Audience=LotteryAnalytics
Cors__AllowedOrigins__0=http://localhost:5173
AdminBootstrap__Username=admin
AdminBootstrap__Password=change-me
WebPush__PublicKey=
WebPush__PrivateKey=
WebPush__Subject=mailto:admin@example.com
